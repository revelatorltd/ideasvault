# Copy to .env. Compose reads this file; .env is gitignored.

# --- required ---------------------------------------------------------------
# Bearer token for every write endpoint. LEAVE THIS EMPTY until you paste a real
# one: unset means writes return 503, so a copied-but-unedited .env fails closed
# instead of leaving the vault writable on a value that is public in this file.
# Compose refuses to start until it is set, which is the guard working.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VAULT_TOKEN=

# --- host user (recommended) ------------------------------------------------
# Run the container as you rather than as root. Without these, everything the
# vault writes -- vault.db, artifacts, _ingested/ -- is owned by root on the
# host, and you need sudo to drop a file in your own inbox, to symlink a sync
# folder over ./inbox (PLAN M4.1), or to tar ./data (M6.1). 1000 is right on
# most single-user machines; this line is exact:
#   printf 'VAULT_UID=%s\nVAULT_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
VAULT_UID=1000
VAULT_GID=1000

# --- Cloudflare (stage 2; leave blank until then) ---------------------------
# Zero Trust -> Networks -> Tunnels -> create tunnel -> copy the token.
# The tunnel only starts with `docker compose --profile edge up -d`.
CF_TUNNEL_TOKEN=

# --- optional overrides -----------------------------------------------------
# Defaults come from the code and suit the container; see docs/SPEC.md 3.1.

# Visibility ceiling for readers: private | internal | public.
# An invalid value stops the container at boot rather than 500ing every page.
# VAULT_VIEWER_LEVEL=private

# Separate hostname for raw artifacts, for origin isolation on top of the
# unique-origin sandbox. Point it at the same container.
# VAULT_RAW_ORIGIN=https://raw.ideas.example.com

# Inbox scan interval, seconds. Pickup takes two polls: a file is held until its
# size and mtime stop changing, so a half-written sync download is never stored.
# VAULT_POLL_SECONDS=2

# Upload limit in bytes. Default is 15 MiB.
# VAULT_MAX_BYTES=15728640

# --- scripts/publish.sh and mcp/server.py -----------------------------------
# VAULT_URL=https://ideas.example.com
